#direction: down
#spacing: 26
#padding: 9
#font: Helvetica
#fontSize: 12
#lineWidth: 1
#edges: hard
#stroke: #000000
#fill: #ffffff

[A|z=0, hinten]
[B|z=1]
[C|z=2, aktiv, vorn]

[A] -- zeichnen: wm_draw --> [B]
[B] --> [C]

[C] -- treffen: wm_hit --> [B]
[B] --> [A]

[<note>Dieselbe Liste, zweimal gegenläufig gelesen:
was zuletzt gezeichnet wird, liegt vorn
und wird zuerst getroffen.]
