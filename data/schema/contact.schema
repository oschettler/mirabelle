# Kontakte. Dieselbe Anwendung wie Aufgaben, andere Felder.

type     contact
folder   Kontakte
label    app.contacts

sort     name asc
columns  name city phone
form     name city phone email body

field name
    kind      text
    label     field.name
    required  yes

field city
    kind   text
    label  field.city

field phone
    kind   text
    label  field.phone

field email
    kind   text
    label  field.email

field body
    kind   gemtext
    label  field.notes
