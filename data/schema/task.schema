# Aufgaben.
#
# Diese Datei ist die Anwendung. Es gibt keinen Programmcode für Aufgaben -
# der Browser liest das hier und baut daraus Liste, Formular und Menü.

type     task
folder   Aufgaben
label    app.tasks

sort     due asc
columns  done title due
form     title due priority category done body

field title
    kind      text
    label     field.title
    required  yes

field due
    kind   date
    label  field.due

field priority
    kind    choice
    label   field.priority
    values  1 2 3 4 5

field category
    kind    choice
    label   field.category
    values  privat arbeit einkauf

field done
    kind   bool
    label  field.done

field body
    kind   gemtext
    label  field.notes
